{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [],
    "paths": { "@wllama/wllama": ["./node_modules/@wllama/wllama/esm/index.d.ts"] }
  },
  "include": ["src", "tests", "server", "vite.config.ts"]
}
